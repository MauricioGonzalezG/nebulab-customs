# Variables privadas del servidor: nunca usar el prefijo VITE_ en secretos.
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-unique-password-of-at-least-16-characters"

# Mercado Pago: el Access Token solo se usa en funciones del servidor.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-XXXXXX"
MERCADOPAGO_CURRENCY="COP"
COP_EXCHANGE_RATE="4000"
APP_URL="https://your-store.example"

# Wompi no está habilitado en el checkout actual. La clave pública se puede exponer;
# el secreto de integridad, si se integra en servidor, debe mantenerse privado.
VITE_WOMPI_PUBLIC_KEY="pub_test_XXXXXX"
VITE_WOMPI_CURRENCY="COP"
VITE_COP_EXCHANGE_RATE="4000"
WOMPI_INTEGRITY_SECRET="test_integrity_XXXXXX"

# Correo: secretos mantenidos en configuración del servidor o en ajustes de administrador.
MAILTRAP_API_TOKEN="your_mailtrap_api_token_here"
MAILTRAP_SENDER_EMAIL="hello@demomailtrap.co"
SMTP_GMAIL_USER="tucorreo@gmail.com"
SMTP_GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Analítica pública del navegador.
VITE_GA_MEASUREMENT_ID="G-ZQVSNJ1CHW"

# Notificaciones del servidor.
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="123456789"
